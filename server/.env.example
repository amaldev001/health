# Server Configuration & Secrets Template
# Copy this file to .env locally and populate values

PORT=5000
MONGODB_URI=mongodb://localhost:27017/healthcare_db
JWT_SECRET=your_jwt_secret_min_32_characters_long
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
CLINIC_TIMEZONE=Asia/Kolkata

# Administrator Seed Credentials (used by npm run create-admin)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=AdminPassword123!

# Clinic Display Settings
CLINIC_NAME=Healthcare Clinic
CLINIC_PHONE=1234567890
CLINIC_ADDRESS=123 Medical Center Blvd
CLINIC_HOURS=09:00-17:00
EMERGENCY_NUMBER=911
CURRENCY=USD
